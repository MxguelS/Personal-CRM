          "parameters": [
            {
              "name": "content",
              "value": "={{\n  \"📅 **Seguimientos de hoy**\\n\\n\" +\n  \"Tienes **\" + $json.total + \"** contacto\" +\n  ($json.total === 1 ? \"\" : \"s\") +\n  \" pendiente\" +\n  ($json.total === 1 ? \"\" : \"s\") +\n  \".\\n\\n\" +\n  $json.items.map((contact, index) => {\n    const nombre =\n      contact.first_name + \" \" + (contact.last_name || \"\");\n\n    const empresa =\n      contact.company || \"Sin empresa\";\n\n    const cargo =\n      contact.job_title || \"Sin cargo\";\n\n    const hora = contact.next_follow_up_at\n      ? new Date(contact.next_follow_up_at).toLocaleTimeString(\"es-PA\", {\n          timeZone: \"America/Panama\",\n          hour: \"2-digit\",\n          minute: \"2-digit\"\n        })\n      : \"Sin hora\";\n\n    return (\n      \"**\" + (index + 1) + \". \" + nombre + \"**\\n\" +\n      \"🏢 \" + empresa + \"\\n\" +\n      \"💼 \" + cargo + \"\\n\" +\n      \"⏰ \" + hora\n    );\n  }).join(\"\\n\\n\")\n}}"
            }
          ]
