# Local development only. No authentication: keep published ports on loopback.
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
POSTGRES_PORT=55432
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Container-to-container origin, baked into the frontend image during build.
API_INTERNAL_URL=http://backend:8000
# Backend CORS allowlist. Browser requests normally use the same-origin proxy.
CORS_ORIGINS=["http://localhost:3000"]
